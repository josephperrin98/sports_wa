# Copy to .env and fill in. .env is git-ignored; this file is the template.
ANTHROPIC_API_KEY=

# Twilio console home page. The auth token also signs every webhook request.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sandbox sender, e.g. whatsapp:+14155238886 (check your Twilio console)
TWILIO_WHATSAPP_FROM=
# Your own number, the only one the bot will answer, e.g. whatsapp:+33600000000
MY_WHATSAPP_NUMBER=
